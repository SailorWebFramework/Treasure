{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "methods.json",
  "description": "Schema for Treasure/json/methods.json — DOM element method definitions.",
  "type": "object",
  "required": ["version", "interfaces"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "interfaces": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/Interface" }
    },
    "tag_interface_map": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Interface": {
      "type": "object",
      "required": ["description", "methods"],
      "properties": {
        "description": { "type": "string" },
        "inherits": { "type": "string" },
        "methods": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/Method" }
        }
      },
      "additionalProperties": false
    },
    "Method": {
      "type": "object",
      "required": ["description", "js_method", "params"],
      "properties": {
        "description": { "type": "string" },
        "js_method": { "type": "string", "minLength": 1 },
        "params": {
          "type": "array",
          "items": { "$ref": "#/definitions/Param" }
        },
        "returns": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "Param": {
      "type": "object",
      "required": ["name", "type", "js_type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "js_type": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" },
        "description": { "type": "string" },
        "default": {}
      },
      "additionalProperties": false
    }
  }
}
